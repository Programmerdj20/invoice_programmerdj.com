---
import type { Product } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-line py-12">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 text-center sm:flex-row sm:justify-between sm:text-left">
    <div class="flex items-center gap-2.5">
      <img
        src="/assets/logo-andres-coock.webp"
        alt="Andres Coock — Fullstack Developer"
        width="32"
        height="32"
        class="h-8 w-8"
        loading="lazy"
      />
      <div>
        <p class="font-heading text-sm font-semibold text-ink">{product.seller.name}</p>
        <p class="text-xs text-ink-faint">{product.seller.role}</p>
      </div>
    </div>

    <a
      href={product.seller.contactUrl}
      target="_blank"
      rel="noopener"
      class="text-sm text-ink-soft transition-colors hover:text-accent"
    >
      {product.seller.contactLabel}
    </a>
  </div>

  <p class="mx-auto mt-8 max-w-6xl px-6 text-center font-mono text-xs text-ink-faint sm:text-left">
    © {year} {product.seller.name}. Los pagos se procesan de forma segura a través de Hotmart.
  </p>
</footer>
