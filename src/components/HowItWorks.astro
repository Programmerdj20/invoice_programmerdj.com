---
import type { HowItWorksStep } from "../data/products";

interface Props {
  steps: HowItWorksStep[];
}

const { steps } = Astro.props;
---

<section id="como-funciona" aria-labelledby="funciona-heading" class="border-t border-line bg-canvas-soft py-24">
  <div class="mx-auto max-w-3xl px-6">
    <div class="animate-on-scroll text-center">
      <span class="font-mono text-xs uppercase tracking-widest text-accent">Después de comprar</span>
      <h2 id="funciona-heading" class="mt-3 text-3xl sm:text-4xl">Cómo funciona</h2>
    </div>

    <ol class="mt-14 space-y-10">
      {
        steps.map((step, index) => (
          <li class="animate-on-scroll relative flex gap-6" style={`transition-delay: ${index * 90}ms`}>
            {index !== steps.length - 1 && (
              <span class="absolute top-11 left-[19px] h-[calc(100%+1.5rem)] w-px bg-line" aria-hidden="true" />
            )}
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line-strong bg-card font-mono text-xs font-medium text-accent">
              {String(step.step).padStart(2, "0")}
            </span>
            <div class="pt-1.5">
              <h3 class="text-base font-semibold text-ink">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
