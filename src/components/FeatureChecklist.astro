---
import type { CopySection } from "../data/products";

interface Props {
  features: CopySection[];
}

const { features } = Astro.props;
---

<section id="que-incluye" aria-labelledby="incluye-heading" class="py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="animate-on-scroll max-w-2xl">
      <span class="font-mono text-xs uppercase tracking-widest text-accent">Auditoría de servicio</span>
      <h2 id="incluye-heading" class="mt-3 text-3xl sm:text-4xl">Qué incluye el mantenimiento</h2>
      <p class="mt-4 text-ink-soft">
        Cada punto se revisa como parte de una rutina fija, no como una promesa vaga.
      </p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {
        features.map((feature, index) => (
          <div
            class="animate-on-scroll group flex items-start gap-4 rounded-xl border border-line bg-card p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-line-strong hover:bg-card-hover"
            style={`transition-delay: ${index * 60}ms`}
          >
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-live/15">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="h-3.5 w-3.5 text-live"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </span>
            <div>
              <h3 class="text-sm font-semibold text-ink">{feature.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{feature.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
