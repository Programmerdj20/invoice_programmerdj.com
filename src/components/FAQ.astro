---
import type { Faq } from "../data/products";

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<section id="faq" aria-labelledby="faq-heading" class="border-t border-line bg-canvas-soft py-24">
  <div class="mx-auto max-w-2xl px-6">
    <div class="animate-on-scroll">
      <span class="font-mono text-xs uppercase tracking-widest text-accent">Preguntas frecuentes</span>
      <h2 id="faq-heading" class="mt-3 text-3xl sm:text-4xl">Antes de contratar</h2>
    </div>

    <div class="mt-10 divide-y divide-line">
      {
        faqs.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-ink marker:content-none">
              <span class="text-base font-medium">{item.question}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="h-5 w-5 shrink-0 text-ink-faint transition-transform duration-200 group-open:rotate-180"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </summary>
            <p class="mt-3 pr-8 text-sm leading-relaxed text-ink-soft">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
