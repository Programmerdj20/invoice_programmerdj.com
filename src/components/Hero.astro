---
import CtaButton from "./CtaButton.astro";
import StatusMonitor from "./StatusMonitor.astro";
import type { Product } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const [headlineBefore, headlineAfter] = product.heroHeadline.split(product.heroHighlight);
---

<section class="relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-28">
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-accent-glow blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-16 px-6 md:grid-cols-2">
    <div class="order-last md:order-first">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-line bg-card px-3.5 py-1.5 font-mono text-xs text-ink-soft"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-live"></span>
        {product.heroBadge}
      </span>

      <h1 class="mt-6 text-4xl sm:text-5xl lg:text-[3.4rem]">
        {headlineBefore}<span class="text-accent">{product.heroHighlight}</span>{headlineAfter}
      </h1>

      <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink-soft">
        {product.heroSubcopy}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-5">
        <CtaButton href="/" label="Contratar soporte" size="lg" />
        <span class="font-mono text-xs text-ink-faint">
          Pago seguro · Hotmart · Cancelas cuando quieras
        </span>
      </div>
    </div>

    <div class="order-first flex justify-center md:order-last md:justify-end">
      <StatusMonitor siteLabel={product.statusMonitor.siteLabel} metrics={product.statusMonitor.metrics} />
    </div>
  </div>
</section>
